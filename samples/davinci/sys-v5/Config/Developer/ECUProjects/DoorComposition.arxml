<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AppComponents</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>DoorSensor</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>DoorState_P</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/AppComponents/DoorState_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>KeyReceiver</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>RemoteKey_P</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/AppComponents/RemoteKey_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <COMPOSITION-SW-COMPONENT-TYPE>
          <SHORT-NAME>BodyComposition</SHORT-NAME>
          <COMPONENTS>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Sensor</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/AppComponents/DoorSensor</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Key</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/AppComponents/KeyReceiver</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Body</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/AppComponents/BodyControl</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
          </COMPONENTS>
          <CONNECTORS>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Sensor_Body</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/BodyComposition/Sensor</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/BodyComposition/Sensor/DoorState_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/BodyComposition/Body</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/BodyComposition/Body/DoorState_P</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Key_Body</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/BodyComposition/Key</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/BodyComposition/Key/RemoteKey_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/BodyComposition/Body</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/BodyComposition/Body/RemoteKey_R</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
          </CONNECTORS>
        </COMPOSITION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
