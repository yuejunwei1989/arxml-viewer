<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AppComponents</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>HmiPanel</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>TempReq_P</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/AppComponents/TempRequest_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>BlowerActuator</SHORT-NAME>
          <PORTS>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>Blower_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF>/AppComponents/BlowerCmd_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <COMPOSITION-SW-COMPONENT-TYPE>
          <SHORT-NAME>ClimateComposition</SHORT-NAME>
          <COMPONENTS>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Hmi</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/AppComponents/HmiPanel</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Climate</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/AppComponents/ClimateControl</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Blower</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/AppComponents/BlowerActuator</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
          </COMPONENTS>
          <CONNECTORS>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Hmi_Climate</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/ClimateComposition/Hmi</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/ClimateComposition/Hmi/TempReq_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/ClimateComposition/Climate</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/ClimateComposition/Climate/TempReq_R</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Climate_Blower</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/ClimateComposition/Climate</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/ClimateComposition/Climate/Blower_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/AppComponents/ClimateComposition/Blower</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/AppComponents/ClimateComposition/Blower/Blower_R</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
          </CONNECTORS>
        </COMPOSITION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
