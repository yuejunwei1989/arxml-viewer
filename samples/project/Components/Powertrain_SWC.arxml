<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Powertrain</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>EngineControl</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>EngineSpeed_P</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/Powertrain/EngineSpeed_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>ThrottlePosition_P</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/Powertrain/ThrottlePosition_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>VehicleSpeed_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF>/Chassis/VehicleSpeed_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>Missing_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF>/Powertrain/DoesNotExist_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>TransmissionControl</SHORT-NAME>
          <PORTS>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>EngineSpeed_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF>/Powertrain/EngineSpeed_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>ThrottlePosition_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF>/Powertrain/ThrottlePosition_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>GearPosition_P</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/Powertrain/GearPosition_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
