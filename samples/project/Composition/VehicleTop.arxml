<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Vehicle</SHORT-NAME>
      <ELEMENTS>
        <COMPOSITION-SW-COMPONENT-TYPE>
          <SHORT-NAME>VehicleTop</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>GearPosition_P</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF>/Powertrain/GearPosition_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
          <COMPONENTS>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Engine</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Powertrain/EngineControl</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Transmission</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Powertrain/TransmissionControl</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Wheel</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Chassis/WheelSpeedSensor</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>ABS</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Chassis/ABSCtrl</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Brake</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Chassis/BrakeActuator</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
            <COMPONENT-PROTOTYPE>
              <SHORT-NAME>Ghost</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Nowhere/GhostComponent</TYPE-TREF>
            </COMPONENT-PROTOTYPE>
          </COMPONENTS>
          <CONNECTORS>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Engine_Transmission</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/Engine</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/Engine/EngineSpeed_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/Transmission</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/Transmission/EngineSpeed_R</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Engine_Transmission_Throttle</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/Engine</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/Engine/ThrottlePosition_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/Transmission</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/Transmission/ThrottlePosition_R</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Wheel_ABS</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/Wheel</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/Wheel/VehicleSpeed_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/ABS</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/ABS/VehicleSpeed_R</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_ABS_Brake</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/ABS</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/ABS/BrakePressure_P</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/Brake</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/Brake/BrakePressure_R</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <ASSEMBLY-SW-CONNECTOR>
              <SHORT-NAME>C_Broken_Endpoint</SHORT-NAME>
              <PROVIDER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/Brake</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/Brake/NoSuchPort</TARGET-PORT-REF>
              </PROVIDER-IREF>
              <REQUESTER-IREF>
                <CONTEXT-COMPONENT-REF>/Vehicle/VehicleTop/ABS</CONTEXT-COMPONENT-REF>
                <TARGET-PORT-REF>/Vehicle/VehicleTop/ABS/BrakePressure_P</TARGET-PORT-REF>
              </REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <DELEGATION-SW-CONNECTOR>
              <SHORT-NAME>D_Gear</SHORT-NAME>
              <INNER-PORT-IREF>
                <P-PORT-IN-COMPOSITION-REF>/Vehicle/VehicleTop/GearPosition_P</P-PORT-IN-COMPOSITION-REF>
              </INNER-PORT-IREF>
              <OUTER-PORT-REF>/Powertrain/TransmissionControl/GearPosition_P</OUTER-PORT-REF>
            </DELEGATION-SW-CONNECTOR>
          </CONNECTORS>
        </COMPOSITION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
